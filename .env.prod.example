# =======================================================
# PRODUCTION CONFIGURATION TEMPLATE (.env.prod)
# Copy to .env.prod on your production server.
# NEVER commit .env.prod containing real secrets!
# =======================================================

# --- Database Credentials ---
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=cryptobot_db
DATABASE_URL=postgresql+asyncpg://cryptobot:generate_strong_password_here@postgres:5432/cryptobot_db

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=generate_64_character_random_secret_here
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=generate_admin_password_here

# --- Telegram Bot Configuration ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_user_or_channel_id

# --- Trading Defaults & Risk ---
DEFAULT_LEVERAGE=20
CONFIDENCE_THRESHOLD=0.70
LOG_LEVEL=INFO

# --- Docker & GHCR Image Tags ---
IMAGE_TAG=latest
