# =======================================================
# PRODUCTION CONFIGURATION TEMPLATE (.env.prod)
# Copy to .env.prod on your production server.
# NEVER commit .env.prod containing real secrets!
# =======================================================

# --- Environment Mode ---
ENVIRONMENT=production

# --- Database Credentials ---
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=cryptobot_db
DATABASE_URL=postgresql+asyncpg://cryptobot:generate_strong_password_here@postgres:5432/cryptobot_db

# --- Security & JWT Authentication ---
# MUST be generated with a secure random generator (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=generate_64_character_random_secret_here
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=generate_admin_password_here

# --- CORS Allowed Origins (Comma-separated specific domains - NO wildcard allowed in production) ---
CORS_ORIGINS=https://dashboard.yourdomain.com,https://app.yourdomain.com

# --- REST API Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Telegram Bot Configuration ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_user_or_channel_id

# --- Trading Defaults & Risk ---
DEFAULT_LEVERAGE=20
CONFIDENCE_THRESHOLD=0.70
LOG_LEVEL=INFO

# --- Docker & GHCR Image Tags ---
IMAGE_TAG=latest
