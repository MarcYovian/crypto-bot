# =======================================================
# TEMPLATE KONFIGURASI CRYPTO BOT (SYSTEM V2)
# Salin file ini ke ".env" dan isi dengan nilai yang sesuai.
# JANGAN pernah commit file ".env" ke repository!
# =======================================================

# --- Telegram Bot Configuration ---
# Dapatkan TOKEN dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dapatkan User ID Anda dari @userinfobot di Telegram
TELEGRAM_CHAT_ID=123456789

# --- Trading Strategy & Risk Settings ---
# Default Leverage Futures (contoh: 20x)
DEFAULT_LEVERAGE=20

# Ambang Batas Confidence Sinyal (0.70 = 70%. Di bawah 70% butuh konfirmasi Yes/No)
CONFIDENCE_THRESHOLD=0.70

# --- Database Configuration ---
# Catatan: Di dalam Docker Container, gunakan host 'postgres' (bukan localhost)
DATABASE_URL=postgresql+asyncpg://cryptobot:cryptobot_pass@postgres:5432/cryptobot_db

# --- System Logging ---
LOG_LEVEL=INFO
